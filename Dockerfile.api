# Internal voting API for Dokploy Compose.
#
# Serves the same domain services as the Firebase callables, but over the private
# same-origin HTTP contract that nginx exposes at /api/v1/. No Cloud Functions
# deployment and no Firebase billing upgrade are involved.
#
# Runtime credentials are NOT baked into this image: Compose supplies the
# server-only FIREBASE_ADMIN_CREDENTIALS_BASE64 runtime secret.

FROM node:22-alpine AS deps
WORKDIR /app
COPY functions/package.json functions/package-lock.json ./
# Production dependencies only (firebase-admin at runtime; firebase-functions is
# part of the functions manifest and stays available for the callable exports).
RUN npm ci --omit=dev && npm cache clean --force

FROM node:22-alpine
ENV NODE_ENV=production \
    PORT=3001
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY functions/package.json ./
# Only the server sources this process loads.
COPY functions/src/api ./src/api
COPY functions/src/awards ./src/awards
COPY functions/src/admin ./src/admin
COPY functions/src/errors.js ./src/errors.js

# Run the API without root privileges; credentials are loaded only at runtime.
USER node

EXPOSE 3001
CMD ["node", "src/api/index.js"]
